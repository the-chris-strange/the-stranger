import { defineConfig } from 'vitest/config'

const name = '<%= project %>' as const
const projectPath = `<%= projectPath %>/${name}` as const
const cacheDir = `<%= cachePath %>/${projectPath}` as const

export default defineConfig(() => ({
  cacheDir,

  root: import.meta.dirname,

  test: {
    coverage: {
      exclude: ['src/test/**', 'src/**/*.d.ts'],
      include: ['src/**/*.ts']
      <% if (coverageProvider !== 'v8') { %> provider: '<%= coverageProvider %>' as const, <% } %>
      reportsDirectory: `<%= coveragePath %>/${projectPath}`,
    },
    <% if (testEnvironment !== 'node') { %> environment: '<%= testEnvironment %>', <% } %>
    globals: <%= globals %>,
    include: ['{src,test}/**/*.{test,spec}.?(c|m)[jt]s?(x)'],
    name,
    passWithNoTests: true,
    typecheck: {
      include: [
        'src/**/*.{test,spec}.?(c|m)[jt]s?(x)',
        'src/**/*.{test,spec}-d.?(c|m)[jt]s?(x)',
      ],
    },
    watch: false,
  },
}))
