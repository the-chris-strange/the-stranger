import { join } from 'node:path'

import { nxCopyAssetsPlugin } from '@nx/vite/plugins/nx-copy-assets.plugin'
import dts from 'vite-plugin-dts'
import { nxViteTsPaths } from '@nx/vite/plugins/nx-tsconfig-paths.plugin'
<%_ if (react) { _%> import react from '<%= paths.reactPlugin %>' <%_ } _%>
import { defineConfig } from 'vite'

export default defineConfig(() => ({
  build: {
    commonjsOptions: {
      transformMixedEsModules: true,
    },
    emptyOutDir: true,
    <%_ if (projectType === 'library') { %> lib: {
      entry: 'src/index.ts',
      fileName: 'index',
      formats: [<%- formats.map(e => `'${e}' as const`).join(', ') %>],
      name: '<%= projectName %>',
    }, <%_ } %>
    outDir: '<%= paths.buildOutput %>',
    reportCompressedSize: true,
    <%_ if (rollupExternals?.length) { %> rollupOptions: { external: [<%- rollupExternals.map(e => `'${e}'`).join(', ') %>] }, <%_ } %>
    <%_ if (target?.length) { %> target: [<%- target.map(e => `'${e}'`).join(', ') %>], <%_ } %>
  },

  cacheDir: '<%= paths.viteCache %>',

  plugins: [
    <%_ if (react) { %> react(), <% } _%>
    nxViteTsPaths(),
    nxCopyAssetsPlugin(['*.md']),
    dts({
      entryRoot: 'src',
      tsconfigPath: join(import.meta.dirname, 'tsconfig.<%= tsconfigExt %>.json'),
    }),
  ],

  root: import.meta.dirname,

<%_ if (worker) { _%>
  worker: {
    plugins: [ nxViteTsPaths() ],
  },
<%_ } _%>
}))
