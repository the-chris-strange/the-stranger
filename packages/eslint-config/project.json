{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "eslint-config",
  "projectType": "library",
  "sourceRoot": "packages/eslint-config/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@the-stranger/nx-plugin-internal:build-package"
    },
    "prepare-publish": {
      "dependsOn": ["nx-plugin-internal:build", "write-directive-header", "^prepare-publish"]
    },
    "watch-tests": {},
    "write-directive-header": {
      "cache": true,
      "dependsOn": ["build", "nx-plugin-internal:build"],
      "executor": "@the-stranger/nx-plugin-internal:write-file-header",
      "inputs": ["{projectRoot}/dist/index.d.ts"],
      "outputs": ["{projectRoot}/dist/index.d.ts"],
      "options": {
        "files": ["packages/eslint-config/dist/index.d.ts"],
        "header": [
          "// this directive is necessary until an official type declaration becomes available for `eslint-plugin-promise`",
          "/// <reference path=\"./types.d.ts\" preserve=\"true\" />"
        ]
      }
    }
  }
}
