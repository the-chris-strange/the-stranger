{
  "name": "root",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "constraints": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/constraints/constraints.mjs"
      },
      "configurations": {
        "fix": {
          "command": "node tools/constraints/constraints.mjs --fix"
        }
      }
    },
    "constraints-test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/constraints/constraints.test.mjs"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "inputs": [
        "eslintConfigs",
        "{workspaceRoot}/**/*",
        "{workspaceRoot}/.*",
        "{workspaceRoot}/.*/**/*",
        "!{workspaceRoot}/.husky/**/*",
        "!{workspaceRoot}/.codexignore",
        "!{workspaceRoot}/.dcignore",
        "!{workspaceRoot}/.gitattributes",
        "!{workspaceRoot}/.prettierignore",
        "!{workspaceRoot}/.vscode/mcp.json",
        "!{workspaceRoot}/packages/**/*",
        "!{workspaceRoot}/**/LICENSE",
        "!{workspaceRoot}/pnpm-lock.yaml",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "command": "eslint .",
        "ignore-pattern": "{packages,tools/nx-plugin}/**/*"
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "config": ".verdaccio/config.yml",
        "port": 4873,
        "storage": "node_modules/.local-registry/storage"
      }
    }
  },
  "includedScripts": []
}
