{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "affected": {
    "legacy": true
  },
  "generators": {
    "@nx/js": {
      "library": {
        "bundler": "tsc",
        "linter": "none",
        "unitTestRunner": "none",
        "useProjectJson": true
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "eslintConfigs": ["{workspaceRoot}/eslint.config.?([cm])[jt]s", "{projectRoot}/eslint.config.?([cm])[jt]s"],
    "noEslintConfigs": ["!{workspaceRoot}/eslint.config.?([cm])[jt]s", "!{projectRoot}/eslint.config.?([cm])[jt]s"],
    "noTestFiles": [
      "!{projectRoot}/**/*.spec.?([cm])[jt]s?(x)",
      "!{projectRoot}/**/*.test.?([cm])[jt]s?(x)",
      "!{projectRoot}/vite?(st).config.?([cm])[jt]s?(x)",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "production": ["default", "noEslintConfigs", "noTestFiles"],
    "productionCode": ["production", "!{projectRoot}/**/*.md", "!{projectRoot}/**/*.json"],
    "sharedGlobals": []
  },
  "nxCloudId": "67eeb7b904dc9617051c453f",
  "parallel": 7,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "build": false,
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "run",
        "testTargetName": "test"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testMode": "watch",
        "testTargetName": "watch-tests"
      }
    }
  ],
  "release": {
    "changelog": {
      "git": {
        "commit": false,
        "stageChanges": false,
        "tag": false
      },
      "projectChangelogs": true,
      "workspaceChangelog": {
        "createRelease": "github",
        "file": false
      }
    },
    "projectsRelationship": "independent",
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "git": {
        "commit": false,
        "stageChanges": false,
        "tag": true
      },
      "manifestRootsToUpdate": ["{projectRoot}", "{workspaceRoot}/dist/{projectRoot}"],
      "preserveLocalDependencyProtocols": true,
      "specifierSource": "conventional-commits",
      "versionPrefix": "^"
    }
  },
  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^productionCode",
        "{workspaceRoot}/tools/build-package.mjs",
        {
          "externalDependencies": ["@typescript/native"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}", "{workspaceRoot}/out-tsc/{projectRoot}"],
      "options": {
        "command": "node tools/build-package.mjs {projectRoot}"
      }
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "eslintConfigs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "fix": {
          "fix": true
        },
        "warnings": {
          "max-warnings": 0
        }
      }
    },
    "nx-release-publish": {
      "dependsOn": ["^nx-release-publish", "build"],
      "options": {}
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "noEslintConfigs",
        "^productionCode",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "env": "GITHUB_ACTIONS"
        }
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/node_modules/.vitest/{projectRoot}/test-results.json"
      ],
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "typecheck": {
      "dependsOn": ["build", "^typecheck"],
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        {
          "dependentTasksOutputFiles": "**/*.d.?([cm])ts"
        },
        {
          "externalDependencies": ["typescript"]
        },
        {
          "externalDependencies": ["@typescript/native"]
        }
      ],
      "outputs": [
        "{workspaceRoot}/out-tsc/{projectRoot}/tsconfig.?(*.)tsbuildinfo",
        "{workspaceRoot}/out-tsc/{projectRoot}/**/*.d.?([cm])ts?(.map)"
      ],
      "options": {
        "command": "node ../../node_modules/@typescript/native/bin/tsc --build --emitDeclarationOnly",
        "cwd": "{projectRoot}"
      }
    },
    "watch-tests": {
      "cache": false,
      "dependsOn": ["^build"],
      "options": {
        "cwd": "{projectRoot}",
        "watch": true
      },
      "continuous": true
    }
  },
  "tui": {
    "autoExit": true
  }
}
