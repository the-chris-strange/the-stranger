{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": true,
  "generators": {
    "@nx/js": {
      "library": {
        "bundler": "tsc",
        "linter": "none",
        "unitTestRunner": "none",
        "useProjectJson": true
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "eslintConfigs": ["{workspaceRoot}/eslint.config.?([cm])[jt]s", "{projectRoot}/eslint.config.?([cm])[jt]s"],
    "noEslintConfigs": ["!{workspaceRoot}/eslint.config.?([cm])[jt]s", "!{projectRoot}/eslint.config.?([cm])[jt]s"],
    "noTestFiles": [
      "!{projectRoot}/**/*.spec.?([cm])[jt]s?(x)",
      "!{projectRoot}/**/*.test.?([cm])[jt]s?(x)",
      "!{projectRoot}/vite?(st).config.?([cm])[jt]s?(x)",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "production": ["default", "noEslintConfigs", "noTestFiles"],
    "productionCode": ["production", "!{projectRoot}/**/*.md", "!{projectRoot}/**/*.json"],
    "sharedGlobals": []
  },
  "nxCloudId": "67eeb7b904dc9617051c453f",
  "parallel": 7,
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "build": {
          "buildDepsName": "build-deps",
          "configName": "tsconfig.lib.json",
          "targetName": "build",
          "watchDepsName": "watch-deps"
        },
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    }
  ],
  "release": {
    "changelog": {
      "git": {
        "commit": false,
        "stageChanges": false,
        "tag": false
      },
      "projectChangelogs": true,
      "workspaceChangelog": {
        "createRelease": "github",
        "file": false
      }
    },
    "projectsRelationship": "independent",
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "git": {
        "commit": false,
        "stageChanges": false,
        "tag": true
      },
      "manifestRootsToUpdate": ["{projectRoot}"],
      "preserveLocalDependencyProtocols": true,
      "specifierSource": "conventional-commits",
      "versionPrefix": "^"
    }
  },
  "sync": {
    "disabledTaskSyncGenerators": ["@nx/js:typescript-sync"]
  },
  "targetDefaults": {
    "@the-stranger/nx-plugin-internal:build-package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "assets": [
          {
            "glob": "**/!(*.ts)",
            "ignore": ["**/__snapshots__/**"],
            "input": "{projectRoot}/src",
            "output": "."
          },
          {
            "glob": "**/*.d.ts",
            "input": "{projectRoot}/src",
            "output": "."
          },
          {
            "glob": "{executors,generators}.json",
            "input": "{projectRoot}",
            "output": "."
          }
        ],
        "generatePackageJson": true,
        "main": "{projectRoot}/src/index.ts",
        "outputPath": "{projectRoot}/dist",
        "rootDir": "{projectRoot}/src",
        "tsConfig": "{projectRoot}/tsconfig.lib.json"
      }
    },
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "eslintConfigs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "fix": {
          "fix": true
        },
        "warnings": {
          "max-warnings": 0
        }
      }
    },
    "nx-release-publish": {
      "dependsOn": ["prepare-publish"],
      "options": {
        "access": "public",
        "packageRoot": "{workspaceRoot}/tmp/publish/{projectRoot}"
      }
    },
    "prepare-publish": {
      "cache": true,
      "dependsOn": ["nx-plugin-internal:build", "build", "^prepare-publish"],
      "executor": "@the-stranger/nx-plugin-internal:workspace-dependencies",
      "inputs": ["default", "{workspaceRoot}/LICENSE"],
      "outputs": ["{workspaceRoot}/tmp/publish/{projectRoot}"],
      "options": {
        "destination": "{workspaceRoot}/tmp/publish/{projectRoot}",
        "source": "{projectRoot}",
        "stage": true
      }
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "noEslintConfigs",
        "^productionCode",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "env": "GITHUB_ACTIONS"
        }
      ],
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}",
        "{workspaceRoot}/node_modules/.vitest/{projectRoot}/test-results.json"
      ],
      "options": {
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "coverage": {
          "coverage": true
        }
      }
    },
    "watch-tests": {
      "cache": false,
      "executor": "@nx/vitest:test",
      "options": {
        "cwd": "{projectRoot}",
        "watch": true
      },
      "continuous": true
    }
  },
  "tui": {
    "autoExit": true
  }
}
