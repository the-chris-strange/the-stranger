{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "assetPattern": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "glob": { "type": "string" },
            "ignore": {
              "items": { "type": "string" },
              "type": "array"
            },
            "includeIgnoredFiles": { "default": false, "type": "boolean" },
            "input": { "type": "string" },
            "output": { "type": "string" }
          },
          "required": ["glob", "input", "output"],
          "type": "object"
        },
        { "type": "string" }
      ]
    },
    "transformerPattern": {
      "oneOf": [
        { "type": "string" },
        {
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "options": { "additionalProperties": true, "type": "object" }
          },
          "required": ["name"],
          "type": "object"
        }
      ]
    }
  },
  "description": "Builds a TypeScript package and makes its project-local dist metadata resolve files relative to dist.",
  "properties": {
    "assets": {
      "default": [],
      "description": "Static assets copied into the build output.",
      "items": {
        "$ref": "#/definitions/assetPattern"
      },
      "type": "array"
    },
    "clean": {
      "default": true,
      "description": "Remove previous output before build.",
      "type": "boolean"
    },
    "generatePackageJson": {
      "default": true,
      "description": "Generate and finalize package.json in the build output.",
      "type": "boolean"
    },
    "main": {
      "description": "The main TypeScript entry point.",
      "type": "string"
    },
    "outputPath": {
      "description": "The project-local distribution directory.",
      "type": "string"
    },
    "rootDir": {
      "description": "The TypeScript source root.",
      "type": "string"
    },
    "transformers": {
      "default": [],
      "description": "TypeScript transformer plugins.",
      "items": {
        "$ref": "#/definitions/transformerPattern"
      },
      "type": "array"
    },
    "tsConfig": {
      "description": "The TypeScript configuration file.",
      "type": "string"
    },
    "watch": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": ["main", "outputPath", "tsConfig"],
  "title": "Build Package",
  "type": "object",
  "version": 2
}
